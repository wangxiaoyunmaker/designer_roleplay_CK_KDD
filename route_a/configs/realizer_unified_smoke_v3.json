{
  "schema_version": "1.2.0",
  "experiment_id": "route_a_realizer_unified_smoke_v3",
  "variant": "unified_multitask_v3",
  "main_task": "FULL_SEQUENCE_RESPONSE",
  "auxiliary_task": "SINGLE_DECISION_RATIONALE",
  "auxiliary_questions": ["Q1", "Q3", "Q4", "Q5", "Q6"],
  "include_no_kc_state": true,
  "include_v7_synthetic": true,
  "target_token_shares": {
    "q2": 0.65,
    "aux_visible": 0.10,
    "aux_masked": 0.20,
    "v7": 0.05
  },
  "loss_weights": {
    "q2": 1.00,
    "aux_visible": 0.25,
    "aux_masked": 0.35,
    "v7": 0.10
  },
  "v30_swap": {
    "enabled": true,
    "loss_weight": 0.15,
    "margin": 0.05,
    "warmup_updates": 1
  },
  "auxiliary_eos_loss_weight": 0.40,
  "selection_metric": "heldout_q2_gated_v2",
  "learning_rate": 0.00008,
  "weight_decay": 0.01,
  "gradient_accumulation_steps": 8,
  "max_input_tokens": 6144,
  "max_updates": 2,
  "patience": 2,
  "evaluation_interval": 1,
  "forbid_q7": true,
  "direct_value_profile_only": true,
  "selection_protocol": {
    "name": "heldout_q2_gated_v2",
    "primary_metric": "q2_full_answer_example_nll",
    "semantic_metric": "bge_m3_cosine",
    "nll_tie_tolerance": 0.01,
    "min_kc_nll_increase": 0.0,
    "min_v30_nll_increase": 0.0,
    "min_length_ratio": 0.50,
    "max_length_ratio": 1.50,
    "max_early_eos_rate": 1.0,
    "max_format_failure_rate": 1.0,
    "early_eos_reference_fraction": 0.30,
    "early_eos_min_characters": 16,
    "generation_max_new_tokens": 64,
    "generation_min_new_tokens": 24,
    "generation_batch_size": 4,
    "semantic_batch_size": 8,
    "semantic_max_tokens": 512,
    "require_gate_pass": false,
    "require_kc_nll_increase": false,
    "min_masked_aux_v30_nll_increase": 0.0
  }
}
